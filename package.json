{
  "name": "fluid-deck",
  "private": true,
  "type": "module",
  "version": "0.1.0",
  "packageManager": "pnpm@11.13.0",
  "engines": {
    "node": ">=26.0.0 <27"
  },
  "scripts": {
    "dev:web": "pnpm --filter @fluid-deck/web dev",
    "dev:ext": "pnpm --filter @fluid-deck/extension dev",
    "build": "pnpm -r --filter \"./apps/*\" build",
    "build:ext": "pnpm --filter @fluid-deck/extension build",
    "typecheck": "pnpm -r typecheck",
    "test": "vitest run",
    "test:e2e": "pnpm build && playwright test --project=chromium --project=firefox --project=edge",
    "test:e2e:preview": "pnpm --filter @fluid-deck/web build && playwright test --config=playwright.preview.config.ts",
    "test:e2e:benchmark": "playwright test --config=playwright.benchmark.config.ts",
    "lint": "eslint .",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.65.0",
    "eslint": "^9.0.0",
    "prettier": "^3.4.0",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.20.0",
    "vitest": "^3.2.0"
  }
}
